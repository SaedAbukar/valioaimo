        text plan_id PK,FK
        text criterion_code PK,FK
        numeric raw_score
        numeric weight "snapshot"
    }
    PLAN_LINE {
        text plan_line_id PK
        text plan_id FK
        text request_line_id FK
        text offer_id FK
