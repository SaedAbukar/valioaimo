        text new_value
    }
    PROCESS_EXCEPTION {
        text exception_id PK
        text process_id FK
        text exception_code FK
        text offer_id FK
        text resolved_by
    }
    PURCHASE_ORDER {
        text order_id PK
        text plan_id FK,UK
        text aimo_order_ref UK
        text placed_at
        text confirmation_jws_sha256
    }
    ORDER_LINE {
        text order_line_id PK
        text order_id FK
