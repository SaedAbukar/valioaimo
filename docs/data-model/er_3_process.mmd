    EVENT {
        text event_id PK
        text site_id FK
        text name
        text event_type
        text service_style "plated buffet"
        text starts_at
        int expected_guests
        int actual_guests
    }
    EVENT_DISH {
        text event_dish_id PK
        text event_id FK
        text recipe_id FK
        int planned_portions
        int served_portions
    }
    PURCHASE_PROCESS {
        text process_id PK "= audit traceId"
        text site_id FK
        text agent_id FK
        text event_id FK
        text context_type "event standing ad_hoc"
        text channel "voice text api"
        text language
        text request_excerpt "max 280 chars"
        text mandate_id FK
        text profile_id FK
        text need_by
        text status
        text created_at
        text closed_at
        int tool_call_count
    }
    REQUEST_LINE {
        text request_line_id PK
        text process_id FK
        text need_group_id FK
        text requested_product_id FK
        text event_dish_id FK
        numeric qty_requested
        text unit_code FK
        numeric qty_from_leftovers
        numeric history_adjustment_pct
    }
    CANDIDATE_EXCLUSION {
        text process_id PK,FK
        text product_id PK,FK
        text reason_code PK,FK
    }
    OFFER {
        text offer_id PK
        text process_id FK
        text product_id FK
