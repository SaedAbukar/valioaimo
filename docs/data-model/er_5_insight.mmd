erDiagram
    CALENDAR_DAY ||--o{ SITE_DAY_CONTEXT : "context for"
    SITE ||--o{ SITE_DAY_CONTEXT : "measured at"
    LABEL_DEFINITION ||--o{ OUTCOME_LABEL : defines
